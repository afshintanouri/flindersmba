{
  "name": "my-project",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:pages": "NEXT_PUBLIC_BASE_PATH=/flindersmba next build",
    "start": "next start",
    "serve": "node scripts/serve-static.mjs out 4173 /flindersmba",
    "test": "playwright test --project=smoke",
    "test:smoke": "playwright test --project=smoke",
    "test:visual": "playwright test --project=visual-*",
    "test:visual:update": "playwright test --project=visual-* --update-snapshots=all",
    "typecheck": "tsc --noEmit",
    "test:unit": "playwright test -c playwright.unit.config.ts",
    "validate:content": "playwright test -c playwright.unit.config.ts -g \"content validation\"",
    "matchmaker:report": "MATCHMAKER_REPORT=1 playwright test -c playwright.unit.config.ts matchmaker-diagnostics --reporter=list",
    "validate:osca": "playwright test -c playwright.unit.config.ts osca",
    "verify:generated-data": "node scripts/verify-generated-data.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.16.0",
    "next": "16.4.6",
    "react": "^19",
    "react-dom": "^19",
    "uqr": "0.1.2"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "jsqr": "1.4.0",
    "postcss": "^8.5",
    "tailwindcss": "^4.3.3",
    "typescript": "5.7.3",
    "zod": "3.25.76"
  }
}
